rules_version = '2';

// ===========================================================================
// Readora — regras do Firestore
//
// App (Android) e site (build web do mesmo app Expo) usam EXATAMENTE a mesma
// estrutura, então uma regra serve aos dois:
//
//   users/{uid}/books/{id}
//   users/{uid}/quotes/{id}
//   users/{uid}/shelves/{id}
//   users/{uid}/sessions/{id}
//   users/{uid}/settings/preferences
//   users/{uid}/sync/metadata
//
// Tudo é privado do dono: ninguém lê ou escreve dados de outro usuário.
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // ---------------------------------------------------------------------
    // Dados do usuário — a árvore inteira sob users/{uid}
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Cobre books, quotes, shelves, sessions, settings e sync de uma vez.
      match /{collection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------------------
    // Coleções do site antigo (raiz, com campo userId). Mantidas apenas para
    // que dados legados continuem acessíveis ao próprio dono — o app atual
    // não escreve aqui.
    // ---------------------------------------------------------------------
    match /books/{bookId} {
      allow read, write: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /quotes/{quoteId} {
      allow read, write: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /shelves/{shelfId} {
      allow read, write: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /reading_sessions/{sessionId} {
      allow read, write: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /retrospectives/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ---------------------------------------------------------------------
    // Nega tudo o que não foi declarado acima.
    // ---------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
