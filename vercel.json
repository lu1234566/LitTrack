{
  "buildCommand": "expo export -p web --clear",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://littrack-2026.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/((?!_expo|assets|favicon|__/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    }
  ]
}
